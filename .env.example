# =============================================================================
# BALKAR NETWORK MANAGER - ENVIRONMENT CONFIGURATION EXAMPLE
# =============================================================================
# Copy this file to .env and customize the values according to your needs
#
# IMPORTANT NOTES:
# - Variables with VITE_ prefix are accessible in frontend (React/Vite)
# - Variables without VITE_ prefix are only accessible in backend (Node.js)
# - DO NOT commit .env file to version control (add to .gitignore)
# =============================================================================

# -----------------------------------------------------------------------------
# SERVER CONFIGURATION
# -----------------------------------------------------------------------------
PORT=5001
NODE_ENV=development

# -----------------------------------------------------------------------------
# APPLICATION INFO
# -----------------------------------------------------------------------------
APP_NAME="Balkar Network Manager"
APP_VERSION=1.0.0
APP_DESCRIPTION="WiFi Network Management & Diagnostic Tool"

# -----------------------------------------------------------------------------
# API ENDPOINTS
# -----------------------------------------------------------------------------
# Backend API base URL (used by frontend to make API calls)
VITE_API_BASE_URL=http://localhost:5001/api

# -----------------------------------------------------------------------------
# NETWORK SERVICES
# -----------------------------------------------------------------------------
# Public IP detection service (json format recommended)
PUBLIC_IP_SERVICE=https://api.ipify.org?format=json
PUBLIC_IP_TIMEOUT=5000

# WiFi SSID detection timeout (milliseconds)
WIFI_DETECTION_TIMEOUT=3000

# -----------------------------------------------------------------------------
# ROUTER DEFAULTS
# -----------------------------------------------------------------------------
# Default router IP address
DEFAULT_ROUTER_IP=
VITE_DEFAULT_ROUTER_IP=

# Default router credentials (for initial form values)
DEFAULT_ROUTER_USERNAME=admin
VITE_DEFAULT_ROUTER_USERNAME=admin

DEFAULT_ROUTER_PASSWORD=admin
VITE_DEFAULT_ROUTER_PASSWORD=admin

# -----------------------------------------------------------------------------
# SECURITY SCANNER
# -----------------------------------------------------------------------------
# Security scan timeout (milliseconds) - max time for full scan
SECURITY_SCAN_TIMEOUT=60000
VITE_SECURITY_SCAN_TIMEOUT=60000

# Request timeout for each router authentication attempt (milliseconds)
SECURITY_REQUEST_TIMEOUT=3000

# Maximum attempts for credential testing
SECURITY_MAX_ATTEMPTS=25

# -----------------------------------------------------------------------------
# NETWORK DIAGNOSTICS
# -----------------------------------------------------------------------------
# Diagnostic test timeout (milliseconds)
DIAGNOSTIC_TEST_TIMEOUT=5000

# Bandwidth test timeout (milliseconds) - downloading test file
DIAGNOSTIC_BANDWIDTH_TIMEOUT=15000

# Bandwidth test URL (Cloudflare speed test)
DIAGNOSTIC_BANDWIDTH_URL=https://speed.cloudflare.com/__down?bytes=5000000

# Ping server for latency test (Google DNS)
DIAGNOSTIC_PING_SERVER=8.8.8.8

# -----------------------------------------------------------------------------
# PDF EXPORT CONFIGURATION
# -----------------------------------------------------------------------------
VITE_PDF_TITLE="WiFi Diagnostic Report"
VITE_PDF_FILENAME="wifi-diagnostic-report.pdf"

# -----------------------------------------------------------------------------
# SOCIAL MEDIA SHARING
# -----------------------------------------------------------------------------
VITE_WHATSAPP_SHARE_TEXT="WiFi Diagnostic Report"
VITE_INSTAGRAM_CARD_TITLE="Network Diagnostics"

# -----------------------------------------------------------------------------
# SPEED TEST
# -----------------------------------------------------------------------------
# Speed test server URL (if using custom server)
SPEEDTEST_SERVER_URL=https://speed.cloudflare.com

# Speed test timeout (milliseconds)
SPEEDTEST_TIMEOUT=30000
